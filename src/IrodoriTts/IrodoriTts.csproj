<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IrodoriTts</RootNamespace>
    <AssemblyName>IrodoriTts</AssemblyName>
    <Description>C# (TorchSharp) port of Irodori-TTS inference.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed TorchSharp API only. The host application chooses the native backend
         (TorchSharp-cpu / TorchSharp-cuda-windows / TorchSharp-cuda-linux). -->
    <PackageReference Include="TorchSharp" Version="0.107.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IrodoriTts.Tests" />
  </ItemGroup>

</Project>

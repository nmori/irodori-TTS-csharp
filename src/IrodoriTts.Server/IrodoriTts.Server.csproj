<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>irodori-tts-server</AssemblyName>
    <RootNamespace>IrodoriTts.Server</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Native libtorch backend: cpu (default) or cuda. Build with -p:TorchBackend=cuda for NVIDIA GPUs. -->
    <TorchBackend Condition="'$(TorchBackend)' == ''">cpu</TorchBackend>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IrodoriTts\IrodoriTts.csproj" />
    <ProjectReference Include="..\IrodoriTts.Onnx\IrodoriTts.Onnx.csproj" />
    <Compile Include="..\Shared\TtsBackend.cs" Link="Shared\TtsBackend.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- response_format "opus": managed Opus encoder (BSD-3-Clause, the Opus license; license\Concentus_BSD-3-Clause.txt). -->
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default voices folder shipped next to the exe (users drop WAV files here). -->
    <None Include="voices\README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Preset characters: no-reference voices generated with fixed seeds (see voices\README.txt), selectable out of the box. -->
    <None Include="voices\*.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Opens the character studio (starts the server first when it is not running). -->
    <None Include="キャラクター作成.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licenses of everything in the package (license\README.txt): this folder, the texts shared with the sample,
         the repository's own license, the models' licenses, and ONNX Runtime's notices from its NuGet package. -->
    <None Include="license\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\samples\SpeakServer\license\*.txt" Exclude="..\..\samples\SpeakServer\license\README.txt" Link="license\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="license\Irodori-TTS-csharp_MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\tools\onnx_export\licenses\*.txt" Link="license\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.30.0\ThirdPartyNotices.txt" Link="license\OnnxRuntime_ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.30.0\ThirdPartyNotices.txt')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Character studio page served at GET / -->
    <EmbeddedResource Include="Studio.html" LogicalName="Studio.html" />
  </ItemGroup>

  <ItemGroup Condition="'$(TorchBackend)' == 'cpu'">
    <PackageReference Include="TorchSharp-cpu" Version="0.107.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TorchBackend)' == 'cuda' And $([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.107.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TorchBackend)' == 'cuda' And $([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="TorchSharp-cuda-linux" Version="0.107.0" />
  </ItemGroup>

  <!--
    CPU package (the distributed one): keep LibTorch out of the exe's folder, in libtorch-cpu\. At start-up
    LibTorchRuntime loads either this or the CUDA build downloaded on an NVIDIA PC; both carry torch_cpu.dll /
    c10.dll, and a copy next to the exe would be loaded as well (TorchSharp probes the exe's folder by full path).
  -->
  <Target Name="MoveCpuLibTorchToSubfolder" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(TorchBackend)' == 'cpu' And $(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <_CpuLibTorch Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'libtorch-cpu-win-x64'" />
      <ResolvedFileToPublish Remove="@(_CpuLibTorch)" />
      <ResolvedFileToPublish Include="@(_CpuLibTorch)" RelativePath="libtorch-cpu\%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!--
    NVIDIA DLLs that come with libtorch but are not on the redistributable list (Attachment A of the CUDA EULA)
    and that nothing in the package loads: cusolverMg (multi-GPU solver) and nvperf_host (profiler host).
    Keep them out of the output so the package only ships redistributable NVIDIA files.
  -->
  <Target Name="DropNonRedistributableNvidiaFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(TorchBackend)' == 'cuda'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'cusolverMg64_11.dll' Or '%(Filename)%(Extension)' == 'nvperf_host.dll'" />
    </ItemGroup>
  </Target>

</Project>
